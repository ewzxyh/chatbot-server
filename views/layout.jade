doctype html
html
  head
    style(type="text/css").
      @font-face {
        font-family: "Geist Sans";
        src: url("/fonts/geist/Geist-Variable.woff2") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }

      * {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    
      body{
        background-color: #eeeeee;
      }
      .transcript-container {
        padding: 25px 25px 5px;
      }
      input {
        width: 80%;
      }
      img{
        width: 200px;
      }
      .transcript-wrapper{
        background-color: #ffffff;
        padding: 15px 15px 25px;
        border: 1px solid #e1eef4;
        border-radius: 5px;
      }
      .transcript-title {
        font: 28px "Geist Sans", "Lucida Grande", Helvetica, Arial, sans-serif;
        font-weight: bold;
        color: #ee7467;
        text-align: center;
      }
      .transcript-p {
        font: 14px "Geist Sans", "Lucida Grande", Helvetica, Arial, sans-serif;
        background-color: #ffffff;
        padding: 10px;
        border-bottom: 1px solid #e1eef4;
        margin-top:0;
        margin-bottom:0px;
        
      }
      .transcript-chat-date{
        color:#657786;
        padding-right: 15px;
        font-size:13px;
        }
      .transcript-chat-sender{
        color:#7695a5;
        font-weight: 600;
      }
      .transcript-chat-msg{
        color:#7695a5;
        font-weight: 400;
      }
      .transcript-powered-by{
        font: 12px "Geist Sans", "Lucida Grande", Helvetica, Arial, sans-serif;
        color:#7695a5;
        font-weight: 600;
        text-align: right;
      }
      a{
        color:#00B7FF
      }

    title= (brandName ? brandName + " - Transcrição do chat" : (title ? title + " - Transcrição do chat" : "Transcrição do chat"))
    //- link(rel='stylesheet', href='/stylesheets/style.css')
  body
    block content

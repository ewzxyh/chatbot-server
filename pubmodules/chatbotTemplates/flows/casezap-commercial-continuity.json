      "readiness": [
        {
          "channel": "whatsapp",
          "status": "ready",
          "title": "WhatsApp com conversa aberta",
          "description": "Compatível com atendimento dentro de uma conversa aberta; não inicia campanhas nem ativa números."
        },
        {
          "channel": "casezap",
          "status": "ready",
          "title": "CaseZap / UAZAPI",
          "description": "Pronto para homologacao em conversas iniciadas pelo cliente; nao associa nem ativa nenhum numero automaticamente."
        }
      ],
      "checklist": [
        "Revisar textos e aliases no Design Studio.",
        "Testar menu e handoff online e offline em homologacao.",
        "Associar ao numero somente depois de aprovacao explicita."

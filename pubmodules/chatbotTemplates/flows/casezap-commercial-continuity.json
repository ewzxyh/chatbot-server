    "flowReference": {
      "mode": "structure-preserved-content-neutralized",
      "preserveMessageOrder": true,
      "sensitiveContent": "replace_with_placeholder",
      "entryRouting": {
        "customer": "2 -> returning_customer_menu",
        "new": "1 -> new_customer_menu",
        "unknown": "1 -> new_customer_menu"
      },
      "blocks": {
        "start": {
          "label": "Entrada",
          "messagePrefixes": ["Oi, amigo! Tudo bem?", "Pra te encaminhar certinho:"],
          "sequence": ["text", "menu"]
        },
        "menu": {
          "label": "Menu inicial",
          "messagePrefixes": ["Oi, amigo! Tudo bem?", "Pra te encaminhar certinho:"],
          "sequence": ["text", "menu"]
        },
        "new_customer_menu": {
          "label": "Novo cliente",
          "messagePrefixes": ["Vem de indicação de alguém?", "Escolha uma opção:"],
          "sequence": ["text", "menu"],
          "routes": ["catalog_request", "order_request", "human_request"]
        },
        "returning_customer_menu": {
          "label": "Cliente recorrente",
          "messagePrefixes": ["Bom te ver de novo, amigo! Pra continuar:"],
          "sequence": ["text", "menu"],
          "routes": ["catalog_request", "returning_purchase", "human_request"]
        },
        "catalog_request": {
          "label": "Catálogo e PDFs",
          "messagePrefixes": ["Segue a nova tabela 👇"],
          "sequence": ["text", "sticker:[STICKER_TABELA_1]", "sticker:[STICKER_TABELA_2]", "file:[PDF_HORSE_POWER]", "text", "text", "handoff_check"]
        },
        "order_request": {
          "label": "Novo pedido",
          "messagePrefixes": ["Certo! Mande os produtos, as quantidades"],
          "sequence": ["text", "handoff_check"]
        },
        "freight_question": {
          "label": "Dúvida sobre frete",
          "messagePrefixes": ["O frete fica em média R$ 35,00.", "O frete é feito pela Shopee.", "Aqui você paga o frete 👆"],
          "sequence": ["text", "text", "link", "text", "text"]
        },
        "product_question": {
          "label": "Dúvida de produto",
          "messagePrefixes": ["Recebi sua dúvida."],
          "sequence": ["text", "handoff_check"]
        },
        "human_request": {
          "label": "Atendimento humano",
          "messagePrefixes": ["Certo, amigo. Vou chamar a equipe."],
          "sequence": ["text", "handoff_check"]
        },
        "returning_purchase": {
          "label": "Recompra",
          "messagePrefixes": ["Bom te ver de novo! Mande os produtos"],
          "sequence": ["text", "handoff_check"]
        },
        "delivery_support": {
          "label": "Entrega e rastreio",
          "messagePrefixes": ["Entendi, amigo. Mande a referência do pedido"],
          "sequence": ["text", "handoff_check"]
        },
        "after_sales": {
          "label": "Pós-venda",
          "messagePrefixes": ["Poxa, entendi. Mande a referência do pedido"],
          "sequence": ["text", "handoff_check"]
        },
        "payment_receipt": {
          "label": "Comprovante",
          "messagePrefixes": ["Recebi seu aviso de pagamento ou comprovante."],
          "sequence": ["text", "handoff_check"]
        },
        "media_received": {
          "label": "Imagem ou arquivo recebido",
          "messagePrefixes": ["Recebi sua imagem ou arquivo."],
          "sequence": ["text", "handoff_check"]
        },
        "defaultFallback": {
          "label": "Fallback",
          "messagePrefixes": ["Não consegui identificar certinho."],
          "sequence": ["text", "handoff_check"]
        },
        "handoff_check": {
          "label": "Verificar disponibilidade",
          "sequence": ["if_online"]
        },
        "handoff_online": {
          "label": "Atendimento online",
          "messagePrefixes": ["Certo, vou chamar alguém da equipe agora."],
          "sequence": ["text", "agent"]
        },
        "handoff_offline": {
          "label": "Atendimento offline",
          "messagePrefixes": ["Agora não tem ninguém online."],
          "sequence": ["text"]
        }
      }
    }
  },
